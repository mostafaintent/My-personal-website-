# این مقادیر رو از تنظیمات Vercel (Environment Variables) یا داشبورد
# Supabase پروژه‌تون کپی کنید:
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# اختیاری — برای متادیتا/sitemap/robots (لینک canonical، Open Graph، و...).
# روی Vercel معمولاً نیازی نیست (به‌صورت خودکار از VERCEL_URL استفاده می‌شه)
# مگر این‌که دامنه‌ی اختصاصی دارید؛ در آن صورت آدرس نهاییِ سایت را اینجا بگذارید:
NEXT_PUBLIC_SITE_URL=https://example.com
